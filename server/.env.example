PORT=3001

# Minimum time a user must wait between sending potions, in seconds.
POTION_COOLDOWN_SECONDS=60

# Used to translate chat messages into "ภาษาเด็ก Gen Z" before broadcasting.
# Get one at https://console.anthropic.com/ — leave blank to post messages as-is.
ANTHROPIC_API_KEY=

# Optional: sync a real Tuya smart bulb to the "Team Avg" HP color.
# Leave TUYA_DEVICE_ID blank to skip bulb control entirely.
# Get credentials at https://iot.tuya.com/
TUYA_BASE_URL=https://openapi-sg.iotbing.com
TUYA_ACCESS_KEY=
TUYA_SECRET_KEY=
TUYA_DEVICE_ID=

# System prompt used to translate chat messages before broadcasting.
AI_SYSTEM_PROMPT=

# Automatically restart the server daily (self-respawns the process, no
# external process manager required). Set to false to disable.
AUTO_RESTART_ENABLED=true
# 24h HH:MM, interpreted in AUTO_RESTART_TIMEZONE below.
AUTO_RESTART_TIME=00:00
# IANA timezone name.
AUTO_RESTART_TIMEZONE=Asia/Bangkok